# LLM Configuration - uncomment and set the provider you want to use

# OpenAI
# OPENAI_API_KEY=sk-...
# LLM_MODEL=openai/gpt-4o

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=anthropic/claude-sonnet-4-20250514

# Kimi Code (api.kimi.com)
# KIMI_API_KEY=sk-...
# LLM_MODEL=kimi/kimi-for-coding

# OpenRouter
# OPENROUTER_API_KEY=sk-or-...
# LLM_MODEL=openrouter/moonshotai/kimi-k2-0711-code

# Ollama (local)
# LLM_MODEL=ollama/llama3.1

# Grok OAuth (SuperGrok / X Premium+) — no API key needed; users connect via Settings → Cloud & AI
# LLM_PROVIDER=xai-oauth
# LLM_MODEL=xai/grok-4.5

# Grok / xAI API key (alternative to OAuth)
# XAI_API_KEY=xai-...
# LLM_MODEL=xai/grok-3-mini

# Web Search defaults (optional; users can also save encrypted per-account keys in Settings)
# BRAVE_API_KEY=...
# SERPER_API_KEY=...
# TAVILY_API_KEY=...
# EXA_API_KEY=...

# Built-in MCP servers (attached to every agent via CrewAI `mcps` when credentials exist)
# GitHub + Linear are enabled by default on each project.
# GITHUB_TOKEN=ghp_...                         # or GITHUB_PERSONAL_ACCESS_TOKEN / GH_TOKEN
# GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
# LINEAR_API_KEY=lin_api_...                   # or LINEAR_TOKEN
# LINEAR_MCP_URL=https://mcp.linear.app/mcp
# MCP_PREFER_REMOTE=true                       # false → fall back to local npx stdio packages
# MCP_ALLOW_CUSTOM_STDIO=false                 # never execute browser-supplied stdio by default
# MCP_CACHE_TOOLS_LIST=true

# Server
HOST=0.0.0.0
PORT=8000

# Auth / CORS (required for Vercel frontend + Render backend)
# FRONTEND_URL=https://your-app.vercel.app
# COOKIE_SECURE=true

# Required in production when COOKIE_SECURE=true (generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# CREDENTIAL_ENCRYPTION_KEY=
# ALLOW_SHARED_PROVIDER_KEYS=false  # authenticated beta users must bring their own provider key
# APP_ENV=development

# Beta guardrails / cost controls
# CREW_PLANNING=false           # extra planning LLM call per engineering crew (costs tokens)
# CREW_VERBOSE=true             # CrewAI agent/tool console logs (set false in production)
# AGENT_MAX_ITER=6              # maximum reasoning/tool loops for non-engineering phases
# ENGINEER_MAX_ITER=18          # maximum engineering tool loops per build attempt
# AGENT_MAX_EXECUTION_SECONDS=240
# ENGINEER_MAX_EXECUTION_SECONDS=600
# AGENT_MAX_RETRY_LIMIT=1       # provider/runtime retries per agent task
# TASK_GUARDRAIL_MAX_RETRIES=2  # structured-output correction attempts
# MAX_PROMPT_CHARS=20000        # reject prompts longer than this
# MAX_UPLOAD_FILE_CONTEXT_CHARS=20000   # per-file cap when injecting uploads into prompts
# MAX_UPLOAD_CONTEXT_CHARS=60000        # total cap for upload context
# MAX_UPLOAD_FILE_BYTES=10485760        # 10 MB per file
# MAX_UPLOAD_PROJECT_BYTES=52428800     # 50 MB aggregate per project
# MAX_UPLOAD_FILES_PER_PROJECT=20
# MAX_CONCURRENT_BUILDS=3       # server-wide simultaneous builds (0 = unlimited)
# MAX_BUILD_TOKENS=80000        # per-build token budget (0 = unlimited; not recommended for public beta)
